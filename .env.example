# Copie para .env.local (desenvolvimento) ou configure no painel do Easypanel (producao).
# Nunca commite arquivos .env reais.

# Dominio publico do site, sem barra no final. Usado no QR Code. (ja usado no MVP)
SITE_URL=http://localhost:3000

# --- Fase B ---
# Postgres (host interno do servico no Easypanel; nao expor a porta 5432)
DATABASE_URL=postgresql://usuario:senha@host:5432/valecred?schema=public

# Sessao do admin (string aleatoria longa, ex.: openssl rand -base64 48)
SESSION_SECRET=

# Cloudflare R2 (bucket exclusivo do projeto, token restrito a ele)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=https://img.exemplo.com.br

# E-mail dos avisos de lead (Resend)
RESEND_API_KEY=
LEADS_FROM_EMAIL=
LEADS_TO_EMAIL=

# Anti-spam dos formularios (Cloudflare Turnstile)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# IA para descricao de imovel (somente servidor)
GEMINI_API_KEY=
